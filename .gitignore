# Toolchains
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Wrangler's local state, including the simulated R2 bucket `pywrangler dev`
# builds editions into.
.wrangler/
.dev.vars

.DS_Store

# uv.lock is deliberately NOT ignored: this is a deployed application, and the
# Worker should be built from pinned dependencies rather than whatever resolved
# on the machine that ran the deploy.

# Artifacts of the retired local fetch, superseded by R2.
/assets/
/store/
/data.js
/fetch-report.json
/logs/

# pywrangler vendors the runtime SDK here, the way npm vendors node_modules.
# pylock.toml and uv.lock are what pin it; this directory is regenerated.
/python_modules/
