<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily fetch, a little after Kagi News rebuilds its feeds (~08:00 US/Eastern).

     Install with scripts/install-schedule.sh, which rewrites PROJECT_DIR and
     UV_PATH for this machine before loading the job. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kagi-news.magazine</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd PROJECT_DIR &amp;&amp; UV_PATH run fetch_kagi.py</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <!-- False on purpose: this should not fetch on every login. A laptop asleep
       at 08:15 does not lose the day either way -- launchd runs a missed
       StartCalendarInterval once the machine wakes. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>PROJECT_DIR/logs/fetch.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_DIR/logs/fetch.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
